# Optional: point the notification queue at your secure backend endpoint.
# The backend must send the SMS using a provider such as Twilio or Africa's Talking.
# VITE_SMS_API_URL=http://localhost:3000/api/sms
# VITE_SMS_API_KEY=your-backend-token-if-used-by-proxy

# Optional: delegate authentication to the secure server (server/index.mjs).
# When set, the app authenticates against this server (HttpOnly session cookie)
# instead of the clearly-labelled local demo. Leave unset for the local demo.
# VITE_AUTH_API_URL=http://localhost:3001
#
# Server-only settings (do NOT prefix with VITE_ — never expose these to the browser):
# AUTH_SECRET=replace-with-a-long-random-string
# AUTH_ALLOWED_ORIGIN=http://localhost:5173
# AUTH_COOKIE_SECURE=true
# AUTH_DATA_DIR=./server/data
# PORT=3001