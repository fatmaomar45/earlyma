{
  "name": "earlyma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test -c playwright.remote.config.js",
    "test:e2e:single": "playwright test -c playwright.single.config.js",
    "test:e2e:all": "playwright test && playwright test -c playwright.remote.config.js && playwright test -c playwright.single.config.js",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
